    "start": "NODE_ENV=production bun run ./dist/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@scalar/api-reference": "^1.43.8",
    "@scalar/sdk": "^0.1.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-typebox": "^0.3.3",
    "elysia": "latest",
    "env": "^0.0.2",
    "http-status-codes": "^2.3.0",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8"
  },
  "module": "src/index.js"
}